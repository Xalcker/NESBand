# Herramientas descargadas (cc65, emuladores): cada quien las baja con las instrucciones del README
tools/

# Salida de compilación
build/

# Canciones de juegos comerciales: tienen copyright, así que no van en el repositorio.
# Los NSF originales van en songs_src/ y lo que se importa de ellos queda en src/songs/<nombre>/.
# En git solo va la canción original de ejemplo (src/songs/nesband_demo/).
songs_src/
src/songs/*
!src/songs/nesband_demo/
# Canciones originales de NESBand (GPL-2.0-or-later, componidas con audio/compose.py): sí van en git.
!src/songs/tormenta/
!src/songs/luna/
!src/songs/salto/
!src/songs/marcha/
!src/songs/noche/

# Referencias visuales con marcas de terceros (logos de Nintendo, etc.)
docs/referencias/

# Python (uv)
.venv/
__pycache__/
*.egg-info/
